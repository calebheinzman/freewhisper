<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>FreeWhisper</string>
	<key>CFBundleIdentifier</key>
	<string>dev.freewhisper.FreeWhisper</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>FreeWhisper</string>
	<key>CFBundleDisplayName</key>
	<string>FreeWhisper</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both version keys are overwritten in the copied plist by the Makefile,
	     which derives them from the git tag. These committed values only ever
	     ship in an untagged local dev build, and 0.0.0 is meant to look like
	     one. They stay in the file because PlistBuddy `Set` needs the key to
	     already exist. -->
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0</string>

	<!-- 14.4, matching Package.swift, not 14.0: the TCC prompt for audio
	     capture is unreliable before 14.4, so a 14.0 user would get past
	     LaunchServices and then find recording quietly broken. -->
	<key>LSMinimumSystemVersion</key>
	<string>14.4</string>

	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 FreeWhisper contributors. MIT licensed.</string>

	<!-- Menu bar only: no Dock icon, no main window on launch. -->
	<key>LSUIElement</key>
	<true/>

	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- Deep links: `open freewhisper://meetings` and
	     `open "freewhisper://meetings?id=<meeting-id>"`. Useful for scripting,
	     and the only way to reach the window from outside a menu bar app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.freewhisper.FreeWhisper</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>freewhisper</string>
			</array>
		</dict>
	</array>

	<!-- TCC usage strings. NSAudioCaptureUsageDescription is what gates the
	     CoreAudio process tap; it is a separate permission from the microphone
	     and Xcode does not list it in its Info.plist dropdown. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>FreeWhisper records your microphone so it can transcribe what you say in meetings and in dictation. Audio stays on this Mac unless you configure a cloud model yourself.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>FreeWhisper records the audio your Mac plays so it can transcribe the other people in your meetings. Audio stays on this Mac unless you configure a cloud model yourself.</string>
</dict>
</plist>
